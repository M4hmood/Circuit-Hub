<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.AdminOrdersController"
            styleClass="welcome-root"
            prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Label text="// ADMIN CONSOLE" styleClass="page-sub"/>
            <Button text="◆  Dashboard" styleClass="nav-btn"        onAction="#navAdminDashboard"/>
            <Button text="▤  Products"  styleClass="nav-btn"        onAction="#navAdminProducts"/>
            <Button text="≡  Orders"    styleClass="nav-btn,active" onAction="#navAdminOrders"/>
            <Button text="◉  Users"     styleClass="nav-btn"        onAction="#navAdminUsers"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"    styleClass="nav-btn"        onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" style="-fx-background-color: #0F172A;">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

            <FlowPane hgap="14" vgap="14" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="200">
                    <Label text="Orders" styleClass="page-title"/>
                    <Label text="// fulfilment &amp; status board" styleClass="page-sub"/>
                </VBox>
            </FlowPane>

            <!-- KPI strip -->
            <FlowPane hgap="14" vgap="14">
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// total" styleClass="kpi-key"/>
                    <Label fx:id="kpiTotal" text="0" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// pending" styleClass="kpi-key"/>
                    <Label fx:id="kpiPending" text="0" styleClass="kpi-value,kpi-warn"/>
                </VBox>
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// shipped" styleClass="kpi-key"/>
                    <Label fx:id="kpiShipped" text="0" styleClass="kpi-value,kpi-info"/>
                </VBox>
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// delivered" styleClass="kpi-key"/>
                    <Label fx:id="kpiDelivered" text="0" styleClass="kpi-value,kpi-good"/>
                </VBox>
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// revenue" styleClass="kpi-key"/>
                    <Label fx:id="kpiRevenue" text="0.00 TND" styleClass="kpi-value,kpi-accent"/>
                </VBox>
            </FlowPane>

            <FlowPane styleClass="filter-bar" hgap="14" vgap="10" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="220">
                    <Label text="search" styleClass="filter-label"/>
                    <TextField fx:id="searchField" promptText="Order ID or user..." styleClass="search-field" prefWidth="280"/>
                </VBox>
                <VBox spacing="4" minWidth="180">
                    <Label text="status" styleClass="filter-label"/>
                    <ComboBox fx:id="filterCombo" styleClass="combo,combo-box" prefWidth="200"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </FlowPane>

            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="170" minWidth="140"/>
                    <TableColumn fx:id="colUserId"  text="User"     prefWidth="220" minWidth="160"/>
                    <TableColumn fx:id="colDate"    text="Date"     prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="colItems"   text="Items"    prefWidth="80"  minWidth="60"/>
                    <TableColumn fx:id="colTotal"   text="Total"    prefWidth="110" minWidth="90"/>
                    <TableColumn fx:id="colStatus"  text="Status"   prefWidth="170" minWidth="150"/>
                    <TableColumn fx:id="colDetails" text="Details"  prefWidth="160" minWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <VBox fx:id="detailsPanel" spacing="8" styleClass="panel" visible="false" managed="false">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label fx:id="detailsTitle" text="Order items" styleClass="page-sub"/>
                <VBox fx:id="detailsBox" spacing="6"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
