<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.OrdersController"
            styleClass="welcome-root" prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Button text="⌂  Home"     styleClass="nav-btn" onAction="#navHome"/>
            <Button text="▤  Products" styleClass="nav-btn" onAction="#navProducts"/>
            <Button text="◉  Cart"     styleClass="nav-btn" onAction="#navCart"/>
            <Button text="≡  Orders"   styleClass="nav-btn,active" onAction="#navOrders"/>
            <Button text="◈  Profile"  styleClass="nav-btn" onAction="#navProfile"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"   styleClass="nav-btn" onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content-area" spacing="16">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

             <HBox alignment="CENTER_LEFT" spacing="16">
                 <VBox spacing="4">
                     <Label text="Orders" styleClass="page-title"/>
                     <Label fx:id="countLabel" text="// 0 orders" styleClass="page-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox spacing="4">
                    <Label text="filter status" styleClass="filter-label"/>
                    <ComboBox fx:id="statusCombo" styleClass="combo" prefWidth="160"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: #0F172A; -fx-background-color: #0F172A;">
                <VBox fx:id="ordersBox" spacing="12" style="-fx-padding: 4;"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
