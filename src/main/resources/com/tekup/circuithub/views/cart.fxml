<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tekup.circuithub.controllers.CartController"
           styleClass="welcome-root" prefWidth="1280" prefHeight="800">

    <BorderPane>
        <left>
            <VBox styleClass="sidebar" prefWidth="200" spacing="4">
                <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
                <Button text="⌂  Home"     styleClass="nav-btn" onAction="#navHome"/>
                <Button text="▤  Products" styleClass="nav-btn" onAction="#navProducts"/>
                <Button text="◉  Cart"     styleClass="nav-btn,active" onAction="#navCart"/>
                <Button text="≡  Orders"   styleClass="nav-btn" onAction="#navOrders"/>
                <Button text="◈  Profile"  styleClass="nav-btn" onAction="#navProfile"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button text="⏻  Logout"   styleClass="nav-btn" onAction="#onLogout"/>
            </VBox>
        </left>

        <center>
            <VBox styleClass="content-area" spacing="16">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                <VBox spacing="4">
                    <Label text="cart" styleClass="page-title"/>
                    <Label fx:id="itemCountLabel" text="// 0 items" styleClass="page-sub"/>
                </VBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background: #0F172A; -fx-background-color: #0F172A;">
                    <VBox fx:id="itemsBox" spacing="12" style="-fx-padding: 4;"/>
                </ScrollPane>

                <!-- Totals bar -->
                <HBox fx:id="totalsBar" styleClass="totals-bar" spacing="28" alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label text="subtotal" styleClass="total-key"/>
                        <Label fx:id="subtotalLabel" text="0.00 TND" styleClass="total-mid"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="tax (10%)" styleClass="total-key"/>
                        <Label fx:id="taxLabel" text="0.00 TND" styleClass="total-mid"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="total" styleClass="total-key"/>
                        <Label fx:id="totalLabel" text="0.00 TND" styleClass="total-big"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="checkoutBtn" text="▶ PROCEED TO CHECKOUT"
                            styleClass="btn-add-large" onAction="#onCheckout"/>
                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <!-- Success overlay (hidden by default) -->
    <StackPane fx:id="successOverlay" styleClass="success-overlay"
               visible="false" managed="false" mouseTransparent="false">
        <VBox alignment="CENTER" spacing="14">
            <Label fx:id="checkLabel" text="✓" styleClass="success-check"/>
            <Label text="ORDER PLACED" styleClass="success-title"/>
            <Label fx:id="successSub" text="// transaction committed" styleClass="text-secondary,mono"/>
        </VBox>
    </StackPane>
</StackPane>
