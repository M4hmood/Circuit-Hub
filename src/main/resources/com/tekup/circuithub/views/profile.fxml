<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.ProfileController"
            styleClass="welcome-root" prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Button text="⌂  Home"     styleClass="nav-btn" onAction="#navHome"/>
            <Button text="▤  Products" styleClass="nav-btn" onAction="#navProducts"/>
            <Button text="◉  Cart"     styleClass="nav-btn" onAction="#navCart"/>
            <Button text="≡  Orders"   styleClass="nav-btn" onAction="#navOrders"/>
            <Button text="◈  Profile"  styleClass="nav-btn,active" onAction="#navProfile"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"   styleClass="nav-btn" onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area"
                    style="-fx-background: #0F172A; -fx-background-color: #0F172A;">
            <VBox spacing="22">
                <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>

                 <VBox spacing="4">
                     <Label text="Profile" styleClass="page-title"/>
                     <Label text="// operator profile and account stats" styleClass="page-sub"/>
                 </VBox>

                 <!-- Identity card -->
                <HBox fx:id="identityCard" styleClass="panel" spacing="24" alignment="CENTER_LEFT"
                      style="-fx-padding: 24 28 24 28;">
                    <StackPane fx:id="avatar" styleClass="avatar"
                               prefWidth="110" prefHeight="110"
                               maxWidth="110" maxHeight="110">
                        <Label fx:id="initialsLabel" text="--" styleClass="avatar-initials"/>
                    </StackPane>

                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="nameLabel" text="—" styleClass="profile-name"/>
                        <Label fx:id="emailLabel" text="—" styleClass="profile-meta"/>
                        <Label fx:id="joinLabel" text="—" styleClass="profile-meta"/>
                        <Label fx:id="idLabel" text="—" styleClass="profile-meta"/>
                    </VBox>

                    <Button text="⏻ LOG OUT" styleClass="btn-danger" onAction="#onLogout"/>
                </HBox>

                 <!-- Stats -->
                 <Label text="Account Stats" styleClass="page-title"/>

                <GridPane fx:id="statsGrid" hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>

                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="// total orders" styleClass="stat-key"/>
                        <Label fx:id="statOrders" text="0" styleClass="stat-value"/>
                        <Label fx:id="statOrdersSub" text="0 pending · 0 shipped · 0 delivered"
                               styleClass="profile-meta" wrapText="true"/>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                         <Label text="// total spent" styleClass="stat-key"/>
                         <Label fx:id="statSpent" text="0.00" styleClass="stat-value"/>
                         <Label fx:id="statSpentSub" text="avg 0.00 / order" styleClass="profile-meta"/>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="// favorite category" styleClass="stat-key"/>
                        <Label fx:id="statFavorite" text="—" styleClass="stat-value-blue"/>
                        <Label fx:id="statFavoriteSub" text="based on units purchased" styleClass="profile-meta"/>
                    </VBox>
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
