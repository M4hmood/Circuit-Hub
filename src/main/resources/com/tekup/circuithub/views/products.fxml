<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Slider?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.ProductsController"
            styleClass="welcome-root"
            prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Button text="⌂  Home"     styleClass="nav-btn" onAction="#navHome"/>
            <Button text="▤  Products" styleClass="nav-btn,active" onAction="#navProducts"/>
            <Button text="◉  Cart"     styleClass="nav-btn" onAction="#navCart"/>
            <Button text="≡  Orders"   styleClass="nav-btn" onAction="#navOrders"/>
            <Button text="◈  Profile"  styleClass="nav-btn" onAction="#navProfile"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"   styleClass="nav-btn" onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content-area" spacing="18">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <!-- Title row -->
            <FlowPane hgap="14" vgap="10" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="220">
                    <Label text="Components" styleClass="page-title"/>
                    <Label fx:id="resultCount" text="// 0 components" styleClass="page-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="6" alignment="CENTER_RIGHT" styleClass="view-toggle">
                    <Button fx:id="gridBtn" text="▦ grid"
                            styleClass="view-toggle-btn,active"
                            onAction="#onGridView"/>
                    <Button fx:id="listBtn" text="≣ list"
                            styleClass="view-toggle-btn"
                            onAction="#onListView"/>
                </HBox>
            </FlowPane>

            <!-- Filter bar (wraps on narrow widths) -->
            <FlowPane styleClass="filter-bar" hgap="22" vgap="14" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="200">
                    <Label text="category" styleClass="filter-label"/>
                    <ComboBox fx:id="categoryCombo" styleClass="combo" prefWidth="200"/>
                </VBox>

                <VBox spacing="4" minWidth="280">
                    <Label text="max price" styleClass="filter-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Slider fx:id="priceSlider" styleClass="price-slider"
                                min="0" max="200" value="200" prefWidth="240"/>
                        <Label fx:id="priceLabel" text="200 TND" styleClass="mono,text-accent" minWidth="80"/>
                    </HBox>
                </VBox>

                <VBox spacing="4" minWidth="180">
                    <Label text="sort by" styleClass="filter-label"/>
                    <ComboBox fx:id="sortCombo" styleClass="combo" prefWidth="200"/>
                </VBox>

                <VBox spacing="4" minWidth="240" HBox.hgrow="ALWAYS">
                    <Label text="search" styleClass="filter-label"/>
                    <TextField fx:id="searchField" promptText="Name, category, or specs…"
                               styleClass="search-field"/>
                </VBox>

                <VBox spacing="4">
                    <Label text=" " styleClass="filter-label"/>
                    <Button text="✕ clear" styleClass="btn-secondary" onAction="#onClearFilters"/>
                </VBox>
            </FlowPane>

            <!-- Active filter chips -->
            <FlowPane fx:id="activeChipsPane" hgap="8" vgap="8"/>

            <!-- Results -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        styleClass="invisible-scroll"
                        style="-fx-background: #0F172A; -fx-background-color: #0F172A;">
                <FlowPane fx:id="productsPane" hgap="18" vgap="18"
                          style="-fx-background-color: #0F172A; -fx-padding: 8;"/>
            </ScrollPane>

            <!-- Pagination bar -->
            <HBox fx:id="paginationBar" spacing="8" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                <Button fx:id="prevBtn" text="← Prev" styleClass="btn-secondary" onAction="#onPrevPage"/>
                <Label fx:id="pageLabel" text="Page 1 of 1" styleClass="page-sub" minWidth="100" style="-fx-alignment: center;"/>
                <Button fx:id="nextBtn" text="Next →" styleClass="btn-secondary" onAction="#onNextPage"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
