<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Slider?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.ProductsController"
            styleClass="welcome-root"
            prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Button text="⌂  Home"     styleClass="nav-btn" onAction="#navHome"/>
            <Button text="▤  Products" styleClass="nav-btn,active" onAction="#navProducts"/>
            <Button text="◉  Cart"     styleClass="nav-btn" onAction="#navCart"/>
            <Button text="≡  Orders"   styleClass="nav-btn" onAction="#navOrders"/>
            <Button text="◈  Profile"  styleClass="nav-btn" onAction="#navProfile"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"   styleClass="nav-btn" onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content-area" spacing="18">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

             <VBox spacing="4">
                 <Label text="Products" styleClass="page-title"/>
                 <Label fx:id="resultCount" text="// 0 components" styleClass="page-sub"/>
             </VBox>

            <!-- Filter bar -->
            <HBox styleClass="filter-bar" spacing="22" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="category" styleClass="filter-label"/>
                    <ComboBox fx:id="categoryCombo" styleClass="combo" prefWidth="180"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="max price" styleClass="filter-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Slider fx:id="priceSlider" styleClass="price-slider"
                                min="0" max="200" value="200" prefWidth="220"/>
                        <Label fx:id="priceLabel" text="200" styleClass="mono,text-accent"/>
                    </HBox>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="SEARCH" styleClass="filter-label"/>
                    <TextField fx:id="searchField" promptText="Search by name or specs…"
                               styleClass="search-field"/>
                </VBox>

                <VBox spacing="4">
                    <Label text=" " styleClass="filter-label"/>
                    <Button text="✕ clear" styleClass="btn-secondary" onAction="#onClearFilters"/>
                </VBox>
            </HBox>

            <!-- Results -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: #0F172A; -fx-background-color: #0F172A;">
                <FlowPane fx:id="productsPane" hgap="18" vgap="18"
                          style="-fx-background-color: #0F172A; -fx-padding: 8;"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
