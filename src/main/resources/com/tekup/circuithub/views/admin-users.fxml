<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.AdminUsersController"
            styleClass="welcome-root"
            prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Label text="// ADMIN CONSOLE" styleClass="page-sub"/>
            <Button text="◆  Dashboard" styleClass="nav-btn"        onAction="#navAdminDashboard"/>
            <Button text="▤  Products"  styleClass="nav-btn"        onAction="#navAdminProducts"/>
            <Button text="≡  Orders"    styleClass="nav-btn"        onAction="#navAdminOrders"/>
            <Button text="◉  Users"     styleClass="nav-btn,active" onAction="#navAdminUsers"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"    styleClass="nav-btn"        onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" style="-fx-background-color: #0F172A;">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

            <FlowPane hgap="14" vgap="14" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="200">
                    <Label text="Users" styleClass="page-title"/>
                    <Label text="// access &amp; role administration" styleClass="page-sub"/>
                </VBox>
            </FlowPane>

            <!-- KPI strip -->
            <FlowPane hgap="14" vgap="14">
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// total" styleClass="kpi-key"/>
                    <Label fx:id="kpiTotal" text="0" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// admins" styleClass="kpi-key"/>
                    <Label fx:id="kpiAdmins" text="0" styleClass="kpi-value,kpi-accent"/>
                </VBox>
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// users" styleClass="kpi-key"/>
                    <Label fx:id="kpiUsers" text="0" styleClass="kpi-value,kpi-info"/>
                </VBox>
            </FlowPane>

            <FlowPane styleClass="filter-bar" hgap="14" vgap="10" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="220">
                    <Label text="search" styleClass="filter-label"/>
                    <TextField fx:id="searchField" promptText="Name, email, or id..." styleClass="search-field" prefWidth="280"/>
                </VBox>
                <VBox spacing="4" minWidth="180">
                    <Label text="role" styleClass="filter-label"/>
                    <ComboBox fx:id="roleCombo" styleClass="combo,combo-box" prefWidth="200"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </FlowPane>

            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"      text="ID"      prefWidth="160" minWidth="120"/>
                    <TableColumn fx:id="colName"    text="Name"    prefWidth="200" minWidth="140"/>
                    <TableColumn fx:id="colEmail"   text="Email"   prefWidth="240" minWidth="180"/>
                    <TableColumn fx:id="colJoin"    text="Joined"  prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="colRole"    text="Role"    prefWidth="110" minWidth="90"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="220" minWidth="180"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
