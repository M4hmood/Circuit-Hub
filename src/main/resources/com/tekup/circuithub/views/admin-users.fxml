<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.AdminUsersController"
            styleClass="welcome-root"
            prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Label text="// ADMIN CONSOLE" styleClass="page-sub"/>
            <Button text="◆  Dashboard" styleClass="nav-btn"        onAction="#navAdminDashboard"/>
            <Button text="▤  Products"  styleClass="nav-btn"        onAction="#navAdminProducts"/>
            <Button text="≡  Orders"    styleClass="nav-btn"        onAction="#navAdminOrders"/>
            <Button text="◉  Users"     styleClass="nav-btn,active" onAction="#navAdminUsers"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"    styleClass="nav-btn"        onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" style="-fx-background-color: #0F172A;">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Users" styleClass="page-title"/>
                    <Label text="// access &amp; role administration" styleClass="page-sub"/>
                </VBox>
                <TextField fx:id="searchField" promptText="Search by name or email..." styleClass="search-field" prefWidth="280"/>
            </HBox>

            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"    text="ID"       prefWidth="220"/>
                    <TableColumn fx:id="colName"  text="Name"     prefWidth="200"/>
                    <TableColumn fx:id="colEmail" text="Email"    prefWidth="220"/>
                    <TableColumn fx:id="colJoin"  text="Joined"   prefWidth="120"/>
                    <TableColumn fx:id="colRole"  text="Role"     prefWidth="110"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
