<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.AdminProductsController"
            styleClass="welcome-root"
            prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Label text="// ADMIN CONSOLE" styleClass="page-sub"/>
            <Button text="◆  Dashboard" styleClass="nav-btn"        onAction="#navAdminDashboard"/>
            <Button text="▤  Products"  styleClass="nav-btn,active" onAction="#navAdminProducts"/>
            <Button text="≡  Orders"    styleClass="nav-btn"        onAction="#navAdminOrders"/>
            <Button text="◉  Users"     styleClass="nav-btn"        onAction="#navAdminUsers"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"    styleClass="nav-btn"        onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" style="-fx-background-color: #0F172A;">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

            <!-- Header -->
            <FlowPane hgap="14" vgap="14" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="200">
                    <Label text="Products" styleClass="page-title"/>
                    <Label text="// inventory &amp; catalog control" styleClass="page-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" prefWidth="20"/>
                <Button text="+ New Product" styleClass="btn-primary" onAction="#onNew"/>
            </FlowPane>

            <!-- KPI strip -->
            <FlowPane hgap="14" vgap="14">
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// total" styleClass="kpi-key"/>
                    <Label fx:id="kpiTotal" text="0" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// in stock" styleClass="kpi-key"/>
                    <Label fx:id="kpiInStock" text="0" styleClass="kpi-value,kpi-good"/>
                </VBox>
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// low stock" styleClass="kpi-key"/>
                    <Label fx:id="kpiLow" text="0" styleClass="kpi-value,kpi-warn"/>
                </VBox>
                <VBox styleClass="kpi-tile" spacing="4" minWidth="160">
                    <Label text="// out" styleClass="kpi-key"/>
                    <Label fx:id="kpiOut" text="0" styleClass="kpi-value,kpi-bad"/>
                </VBox>
            </FlowPane>

            <!-- Filter strip (responsive) -->
            <FlowPane styleClass="filter-bar" hgap="14" vgap="10" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="220">
                    <Label text="search" styleClass="filter-label"/>
                    <TextField fx:id="searchField" promptText="Name or ID..." styleClass="search-field" prefWidth="280"/>
                </VBox>
                <VBox spacing="4" minWidth="180">
                    <Label text="category" styleClass="filter-label"/>
                    <ComboBox fx:id="categoryCombo" styleClass="combo" prefWidth="200"/>
                </VBox>
                <VBox spacing="4" minWidth="180">
                    <Label text="stock" styleClass="filter-label"/>
                    <ComboBox fx:id="stockCombo" styleClass="combo" prefWidth="200"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox spacing="4">
                    <Label text=" " styleClass="filter-label"/>
                    <Button text="✕ clear" styleClass="btn-secondary" onAction="#onClearFilters"/>
                </VBox>
            </FlowPane>

            <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"       text="ID"       prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="colName"     text="Name"     prefWidth="260" minWidth="160"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="170" minWidth="130"/>
                    <TableColumn fx:id="colPrice"    text="Price"    prefWidth="100" minWidth="80"/>
                    <TableColumn fx:id="colStock"    text="Stock"    prefWidth="120" minWidth="90"/>
                    <TableColumn fx:id="colActions"  text="Actions"  prefWidth="220" minWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
