<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.AdminProductsController"
            styleClass="welcome-root"
            prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Label text="// ADMIN CONSOLE" styleClass="page-sub"/>
            <Button text="◆  Dashboard" styleClass="nav-btn"        onAction="#navAdminDashboard"/>
            <Button text="▤  Products"  styleClass="nav-btn,active" onAction="#navAdminProducts"/>
            <Button text="≡  Orders"    styleClass="nav-btn"        onAction="#navAdminOrders"/>
            <Button text="◉  Users"     styleClass="nav-btn"        onAction="#navAdminUsers"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"    styleClass="nav-btn"        onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" style="-fx-background-color: #0F172A;">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Products" styleClass="page-title"/>
                    <Label text="// inventory &amp; catalog control" styleClass="page-sub"/>
                </VBox>
                <TextField fx:id="searchField" promptText="Search by name or id..." styleClass="search-field" prefWidth="260"/>
                <Button text="+ New Product" styleClass="btn-primary" onAction="#onNew"/>
            </HBox>

            <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"       text="ID"       prefWidth="120"/>
                    <TableColumn fx:id="colName"     text="Name"     prefWidth="240"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="160"/>
                    <TableColumn fx:id="colPrice"    text="Price"    prefWidth="100"/>
                    <TableColumn fx:id="colStock"    text="Stock"    prefWidth="90"/>
                    <TableColumn fx:id="colActions"  text="Actions"  prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
