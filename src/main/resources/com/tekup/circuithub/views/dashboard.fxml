<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tekup.circuithub.controllers.DashboardController"
            styleClass="welcome-root"
            prefWidth="1280" prefHeight="800">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <Label text="◢ CircuitHub" styleClass="sidebar-brand"/>
            <Button text="⌂  Home"     styleClass="nav-btn,active" onAction="#navHome"/>
            <Button text="▤  Products" styleClass="nav-btn" onAction="#navProducts"/>
            <Button text="◉  Cart"     styleClass="nav-btn" onAction="#navCart"/>
            <Button text="≡  Orders"   styleClass="nav-btn" onAction="#navOrders"/>
            <Button text="◈  Profile"  styleClass="nav-btn" onAction="#navProfile"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⏻  Logout"   styleClass="nav-btn" onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area"
                    style="-fx-background: #0F172A; -fx-background-color: #0F172A;">
            <VBox spacing="22">
                <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                <!-- Welcome header -->
                <VBox spacing="4">
                    <Label fx:id="welcomeLabel" text="Welcome" styleClass="page-title"/>
                    <Label text="// pick a category or browse featured drops" styleClass="page-sub"/>
                </VBox>

                <!-- Featured carousel banner -->
                <StackPane fx:id="bannerPane" styleClass="banner" minHeight="160">
                    <HBox alignment="CENTER_LEFT" spacing="28">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="◆ FEATURED" styleClass="banner-sub"/>
                            <Label fx:id="bannerTitle" text="—" styleClass="banner-title"/>
                            <Label fx:id="bannerDesc" text="—" styleClass="text-secondary"
                                   wrapText="true" maxWidth="560"/>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="8">
                            <Label fx:id="bannerPrice" text="Price" styleClass="banner-price"/>
                            <Label fx:id="bannerCategory" text="—" styleClass="banner-sub"/>
                        </VBox>
                    </HBox>
                </StackPane>

                <!-- Categories title -->
                <VBox spacing="4">
                    <Label text="Browse Categories" styleClass="page-title"/>
                    <Label text="// 6 families of components" styleClass="page-sub"/>
                </VBox>

                <!-- 3-column grid -->
                <GridPane fx:id="categoryGrid" hgap="18" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>
                </GridPane>

                <Region prefHeight="20"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
