<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tekup.circuithub.controllers.SignInController"
           styleClass="welcome-root"
           prefWidth="1280" prefHeight="800">

    <VBox styleClass="panel" alignment="TOP_CENTER" spacing="18"
          maxWidth="420" maxHeight="520">
        <padding><Insets top="36" right="32" bottom="32" left="32"/></padding>

        <Label text="CircuitHub" styleClass="logo-label" style="-fx-font-size: 32px;"/>
         <Label text="Sign in to your account" styleClass="text-secondary"
                style="-fx-font-size: 13px;"/>

         <Region prefHeight="14"/>

         <StackPane prefHeight="40">
             <TextField fx:id="emailField" promptText="Email address" styleClass="terminal-field" style="-fx-padding: 10 12 10 35;"/>
             <Label text="✉" StackPane.alignment="CENTER_LEFT" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8; -fx-padding: 0 0 0 12;"/>
         </StackPane>

         <Region prefHeight="10"/>

         <StackPane prefHeight="40">
             <PasswordField fx:id="passwordField" promptText="Password" styleClass="terminal-field" style="-fx-padding: 10 12 10 35;"/>
             <Label text="🔒" StackPane.alignment="CENTER_LEFT" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8; -fx-padding: 0 0 0 12;"/>
         </StackPane>

        <Region prefHeight="6"/>
        <Label fx:id="errorLabel" text=" "
               style="-fx-text-fill: #EF4444; -fx-font-size: 12px;"/>

        <Button text="Sign In" styleClass="btn-primary" onAction="#onLogin" maxWidth="Infinity"/>

        <Region prefHeight="6"/>
        <HBox alignment="CENTER" spacing="6">
            <Label text="New here?" styleClass="text-secondary"/>
            <Hyperlink text="Create account" onAction="#onCreateAccount"
                       style="-fx-text-fill: #3B82F6; -fx-border-color: transparent;"/>
        </HBox>
    </VBox>
</StackPane>
