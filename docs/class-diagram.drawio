        </mxCell>
        <mxCell id="CartItem" parent="1" style="text;html=1;strokeColor=#00ff9c;fillColor=#0f172a;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;spacingBottom=10;rounded=1;arcSize=8;fontColor=#e2e8f0;fontSize=12;strokeWidth=2;shadow=1;" value="&lt;b style=&quot;font-size:15px;color:#00ff9c&quot;&gt;CartItem&lt;/b&gt;&#xa;&lt;span style=&quot;color:#64748b;font-size:10px&quot;&gt;a product + a quantity (one line)&lt;/span&gt;&#xa;──────────────────────&#xa;- product : Product&#xa;- quantity : int&#xa;──────────────────────&#xa;+ getLineTotal() : double   &lt;span style=&quot;color:#64748b&quot;&gt;// price × qty&lt;/span&gt;" vertex="1">
