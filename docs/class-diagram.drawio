        <mxCell id="legend" parent="1" style="text;html=1;strokeColor=#334155;fillColor=#1e293b;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;spacingBottom=10;rounded=1;arcSize=8;fontColor=#e2e8f0;fontSize=11;" value="&lt;b style=&quot;color:#00ff9c;font-size:13px&quot;&gt;Legend&lt;/b&gt;&#xa;────────────────────&#xa;&lt;b&gt;───&lt;/b&gt; &lt;span style=&quot;color:#cbd5e1&quot;&gt;association&lt;/span&gt;&#xa;&lt;span style=&quot;color:#64748b;font-size:10px&quot;&gt;User → Cart, User → Order&lt;/span&gt;&#xa;&#xa;&lt;b style=&quot;color:#00ff9c&quot;&gt;◆──&lt;/b&gt; &lt;span style=&quot;color:#cbd5e1&quot;&gt;composition&lt;/span&gt;&#xa;&lt;span style=&quot;color:#64748b;font-size:10px&quot;&gt;CartItems live only inside their Cart/Order&lt;/span&gt;&#xa;&#xa;&lt;b&gt;◇──&lt;/b&gt; &lt;span style=&quot;color:#cbd5e1&quot;&gt;aggregation&lt;/span&gt;&#xa;&lt;span style=&quot;color:#64748b;font-size:10px&quot;&gt;Product exists independently of CartItem&lt;/span&gt;" vertex="1">
