  <diagram id="circuithub-domain-model" name="CircuitHub Domain Model">
    <mxGraphModel dx="1285" dy="765" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#e2e8f0;fontSize=14;" value="&lt;b style=&quot;font-size:22px;color:#00ff9c&quot;&gt;CircuitHub — Domain Model&lt;/b&gt;&#xa;&lt;span style=&quot;color:#94a3b8;font-size:13px&quot;&gt;The core entities behind the storefront: who buys what, in what quantity, and as part of which order.&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1090" x="280" y="40" as="geometry" />
        </mxCell>
        <mxCell id="User" parent="1" style="text;html=1;strokeColor=#00ff9c;fillColor=#0f172a;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;spacingBottom=10;rounded=1;arcSize=8;fontColor=#e2e8f0;fontSize=12;strokeWidth=2;shadow=1;" value="&lt;b style=&quot;font-size:15px;color:#00ff9c&quot;&gt;User&lt;/b&gt;&#xa;&lt;span style=&quot;color:#64748b;font-size:10px&quot;&gt;the customer or admin&lt;/span&gt;&#xa;──────────────────────&#xa;- id : String&#xa;- fullName : String&#xa;- email : String&#xa;- passwordHash : String&#xa;- joinDate : String&#xa;- role : String   &lt;span style=&quot;color:#64748b&quot;&gt;// USER | ADMIN&lt;/span&gt;&#xa;──────────────────────&#xa;+ isAdmin() : boolean" vertex="1">
          <mxGeometry height="240" width="280" x="80" y="180" as="geometry" />
        </mxCell>
        <mxCell id="Cart" parent="1" style="text;html=1;strokeColor=#00ff9c;fillColor=#0f172a;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;spacingBottom=10;rounded=1;arcSize=8;fontColor=#e2e8f0;fontSize=12;strokeWidth=2;shadow=1;" value="&lt;b style=&quot;font-size:15px;color:#00ff9c&quot;&gt;Cart&lt;/b&gt;&#xa;&lt;span style=&quot;color:#64748b;font-size:10px&quot;&gt;in-memory, session-scoped&lt;/span&gt;&#xa;──────────────────────&#xa;- items : List&lt;CartItem&gt;&#xa;──────────────────────&#xa;+ add(p : Product, qty : int) : void&#xa;+ remove(productId : String) : void&#xa;+ updateQty(productId, qty) : void&#xa;+ clear() : void&#xa;+ subtotal() : double&#xa;+ itemCount() : int&#xa;+ isEmpty() : boolean" vertex="1">
          <mxGeometry height="260" width="300" x="480" y="180" as="geometry" />
        </mxCell>
        <mxCell id="Order" parent="1" style="text;html=1;strokeColor=#00ff9c;fillColor=#0f172a;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;spacingBottom=10;rounded=1;arcSize=8;fontColor=#e2e8f0;fontSize=12;strokeWidth=2;shadow=1;" value="&lt;b style=&quot;font-size:15px;color:#00ff9c&quot;&gt;Order&lt;/b&gt;&#xa;&lt;span style=&quot;color:#64748b;font-size:10px&quot;&gt;a completed purchase&lt;/span&gt;&#xa;──────────────────────&#xa;- id : String&#xa;- userId : String&#xa;- items : List&lt;CartItem&gt;&#xa;- total : double&#xa;- date : String&#xa;- status : String   &lt;span style=&quot;color:#64748b&quot;&gt;// Pending | Shipped&lt;/span&gt;" vertex="1">
